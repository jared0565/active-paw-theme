# Default-deny allowlist — GitHub publishes "theme + docs only".
# The Python admin scripts (shopify_admin.py, cj_client.py, etc.) hardcode LIVE
# Shopify/CJ credentials and must NEVER be pushed. node_modules/, output/, .env,
# graphify tooling, and local .claude/ config are also excluded. Anything not
# explicitly allowed below is ignored — the safe failure mode.
/*

# Theme source (Liquid/CSS/JS/JSON — verified secret-free, see
# docs/shopify-theme-store-compliance.md)
!/assets/
!/config/
!/layout/
!/locales/
!/sections/
!/snippets/
!/templates/

# Documentation + project guide (verified: only format placeholders / test fixtures)
!/docs/
!/CLAUDE.md
!/README.md
!/.gitignore
!/.shopifyignore

# CI: auto-sync theme folders master -> shopify-deploy on every push
!/.github/

# Session setup hooks (credential-free; ensures graphify persists across sessions)
!/.claude/
!/.claude/setup.sh
!/.claude/hooks.json

# Local user settings (machine-specific, not part of shared config)
.claude/settings.local.json
