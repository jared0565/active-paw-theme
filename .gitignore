# Default-deny allowlist - GitHub publishes "theme + docs only".
# The Python admin scripts (shopify_admin.py, cj_client.py, etc.) hardcode LIVE
# Shopify/CJ credentials and must NEVER be pushed. node_modules/, output/, .env,
# graphite tooling, and local .claude/ config are also excluded. Anything not
# explicitly allowed below is ignored - the safe failure mode.
/*

# Theme source (Liquid/CSS/JS/JSON - verified secret-free, see
# docs/shopify-theme-store-compliance.md)
!/assets/
!/config/
!/layout/
!/locales/
!/sections/
!/snippets/
!/templates/

# Documentation + project guide (verified: only format placeholders / test fixtures)
!/docs/
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/GRAPHITE.md
!/.gitignore

graph-out/
.cache/graphite/
.graphite-daemon/

**/.cache/graphite/
**/.graphite/

!/ANTIGRAVITY.md
!/.github/
!/.github/copilot-instructions.md
!/.claude/
/.claude/*
!/.claude/settings.json

.githooks/

!/.vscode/
/.vscode/*
!/.vscode/tasks.json

!/.mcp.json
!/ARAMID.md
!/aramid.toml
.aramid/
.graphite*
.cache/

!/requirements.txt
!/package.json
!/package-lock.json
!/eslint.config.js
!/.theme-check.yml
!/bootstrap-agent-tooling.py

# tests/ is committed file by file: probe_lib.py and its test stay machine-local
!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_bootstrap_agent_tooling.py
!/tests/test_import_cj_category_products.py
!/tests/test_import_cj_products.py
!/tests/test_scrub_products_emdash.py
!/tests/independence.cjs
!/TASKS.md
!/tests/script_stubs.py
