      },
      {
        "type": "text",
        "id": "welcome_chips",
        "label": "Search shortcuts (comma-separated)",
        "default": "Cat trees, Cooling mats, Litter boxes, Dog beds"
      },
      {
        "type": "text",
        "id": "welcome_cta",
        "label": "Browse button text",
        "default": "Start shopping with the offer applied"
      },
      {
        "type": "text",
        "id": "welcome_redirect",
        "label": "Browse destination path",
        "default": "/collections/all"
      }
