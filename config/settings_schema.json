      { "type": "color", "id": "color_ink", "label": "Ink", "default": "#101820" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#F05A28" },
      { "type": "color", "id": "color_surface", "label": "Surface", "default": "#F7F4EF" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "inter_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Contact form",
    "settings": [
      {
        "type": "text",
        "id": "contact_reply_eta",
        "label": "Reply time shown after sending",
        "info": "Shown in the confirmation box after a visitor submits the contact form, e.g. \"We usually reply within 24 hours\".",
        "default": "24 hours"
      }
    ]
  },
  {
    "name": "Welcome offer",
    "settings": [
      {
        "type": "checkbox",
        "id": "welcome_enabled",
        "label": "Event pop-up slot",
        "info": "Master switch for the storewide event pop-up. It opens once per visitor per event (after 3 seconds or their first scroll) and only while PawScout reports a running storewide event; the headline, wording, code and end date all come from that event, so there is nothing to type here. Leave it on unless you never want an offer pop-up.",
