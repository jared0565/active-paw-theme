<section class="cart-page">
  <div class="cart-shell">
    <div class="cart-heading">
      <p class="eyebrow">Basket</p>
      <h1>Your cart</h1>
      <p>
        {% if cart.item_count > 0 %}
          Review your pet-care picks before checkout.
        {% else %}
          Your cart is empty for now.
        {% endif %}
      </p>
    </div>

    {% if cart.item_count > 0 %}
      {% assign cart_has_quantity_issue = false %}
      <form class="cart-layout" action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-items" aria-label="Cart items">
          {% for item in cart.items %}
            {% liquid
              comment
                Cart line availability note. Same display rule as the PDP banner: a
                NUMBER appears only when the real synced quantity is 10 or fewer
                (genuine scarcity); larger stock reads as a plain "In stock". The cap
                priority (tracked -> supplier max order -> supplier qty -> 20) is
                unchanged. Never expose internal sourcing (supplier names, system
                terms) to the customer.
              endcomment

              capture sa
                render 'supplier-availability', variant: item.variant, product: item.product
              endcapture
              assign sa = sa | strip | split: '|'
              assign max_line_quantity = sa[2] | plus: 0
              assign line_has_quantity_issue = false
              assign inventory_note = 'In stock. Quantity is capped per order.'
              if sa[10] == 'true'
                assign inventory_note = 'Available to order. Quantity is capped per order.'
              endif
              if sa[9] == 'supplier_max'
                assign inventory_note = 'In stock. Capped at ' | append: sa[2] | append: ' per order.'
              endif
              if sa[7] == 'true'
                assign line_known_qty = sa[8] | plus: 0
                if line_known_qty <= 0
                  assign inventory_note = 'Currently unavailable.'
                elsif line_known_qty <= 3
                  assign inventory_note = 'Only ' | append: line_known_qty | append: ' left in stock - restock not guaranteed.'
                elsif line_known_qty <= 10
                  assign inventory_note = 'Only ' | append: line_known_qty | append: ' left in stock.'
                else
                  assign inventory_note = 'In stock.'
                endif
              endif
              if sa[6] != blank
                assign inventory_note = inventory_note | append: ' Availability updated ' | append: sa[6] | append: '.'
              endif
              if item.quantity > max_line_quantity
                assign line_has_quantity_issue = true
                assign cart_has_quantity_issue = true
              endif
            %}
            <article class="cart-item">
              <a class="cart-item-media" href="{{ item.url }}" aria-label="View {{ item.product.title | escape }}">
                {% if item.image != blank %}
                  {{ item.image | image_url: width: 220 | image_tag: widths: '120, 180, 220', sizes: '110px', loading: 'lazy', alt: item.image.alt | default: item.product.title }}
                {% else %}
                  <span aria-hidden="true">{{ item.product.title | slice: 0, 1 }}</span>
                {% endif %}
              </a>

              <div class="cart-item-body">
                <div class="cart-item-title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}
                    <span>{{ item.variant.title }}</span>
                  {% endunless %}
                  {% if item.selling_plan_allocation != blank %}
                    <span>{{ item.selling_plan_allocation.selling_plan.name }}</span>
                  {% endif %}
                </div>

                <div class="cart-item-controls">
                  <label for="CartQuantity-{{ forloop.index }}">Quantity</label>
                  <input
                    id="CartQuantity-{{ forloop.index }}"
                    name="updates[]"
                    type="number"
                    min="0"
                    max="{{ max_line_quantity }}"
                    value="{{ item.quantity }}"
                    inputmode="numeric"
                    data-cart-quantity
                    aria-label="Quantity for {{ item.product.title | escape }}"
                  >
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                  <span class="cart-stock-note {% if line_has_quantity_issue %}is-warning{% endif %}">
                    {% if line_has_quantity_issue %}
                      Reduce to {{ max_line_quantity }} or fewer before checkout.
                    {% else %}
                      {{ inventory_note }}
                    {% endif %}
                  </span>
                </div>
              </div>

              <div class="cart-item-price">
                {% if item.original_line_price != item.final_line_price %}
                  <s>{{ item.original_line_price | money }}</s>
                {% endif %}
                <strong>{{ item.final_line_price | money }}</strong>
                {% if item.unit_price_measurement %}
                  <span>
                    {{ item.unit_price | money }} /
                    {% if item.unit_price_measurement.reference_value != 1 %}
                      {{ item.unit_price_measurement.reference_value }}
                    {% endif %}
                    {{ item.unit_price_measurement.reference_unit }}
                  </span>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        <aside class="cart-summary" aria-label="Order summary">
          <div class="cart-summary-card">
            {%- comment -%}
              Subtotal must be the PRE-discount figure. This row used to print
              cart.total_price (which is AFTER discounts) under the label
              "Subtotal", so a cart holding a discount code showed a number
              lower than the line items with nothing explaining the gap - a
              58.99 item summarised as 53.10. In the shopper's favour, but an
              unexplained number at the moment of purchase reads as a fault.
            {%- endcomment -%}
            <div class="cart-summary-row">
              <span>Subtotal</span>
              <strong>{{ cart.original_total_price | money }}</strong>
            </div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-summary-row cart-summary-discount">
                <span>{{ discount.title }}</span>
                <strong>-{{ discount.total_allocated_amount | money }}</strong>
              </div>
            {%- endfor -%}
            {%- if cart.total_discount > 0 -%}
              <div class="cart-summary-row cart-summary-total">
                <span>Total</span>
                <strong>{{ cart.total_price | money }}</strong>
              </div>
            {%- endif -%}
            <p>Shipping and taxes are calculated at checkout.</p>
            {% if cart_has_quantity_issue %}
              <div class="cart-alert" role="alert">
                One or more quantities exceed current order limits. Update the cart before checkout.
              </div>
            {% endif %}

            <div class="cart-summary-actions">
              <button class="button button-secondary" type="submit" name="update">Update cart</button>
              <button class="button button-primary" type="submit" name="checkout" {% if cart_has_quantity_issue %}disabled{% endif %}>Checkout</button>
            </div>

            <a class="cart-continue" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
          </div>
        </aside>
      </form>
    {% else %}
      <div class="cart-empty">
        <strong>No products in your cart yet.</strong>
        <span>Start with grooming essentials, pet toys, or everyday care picks.</span>
        <a class="button button-primary" href="{{ routes.all_products_collection_url }}">Shop all products</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Main cart", "settings": [] }
{% endschema %}
