<section class="search-page">
  <div class="search-shell">
    <div class="search-heading">
      <p class="eyebrow">Search</p>
      {% if search.performed %}
        <h1>Results for "{{ search.terms | escape }}"</h1>
        <p>Products are shown in the same card format as the homepage, with buying actions surfaced for faster checkout.</p>
      {% else %}
        <h1>Find pet care products</h1>
        <p>Search grooming, toys, feeding, walking, and daily care essentials.</p>
      {% endif %}
    </div>

    {% if search.performed %}
      {% paginate search.results by 24 %}
        {% liquid
          assign product_count = 0
          # Boundary-safe membership string: leading AND trailing comma so a short
          # id ('2,') can never substring-match a longer one ('12,').
          assign result_product_ids = ','
          for item in search.results
            if item.object_type == 'product' and item.available
              assign product_count = product_count | plus: 1
              assign result_product_ids = result_product_ids | append: item.id | append: ','
            endif
          endfor

          assign normalized_terms = search.terms | downcase
          # Suggestion rules come from the theme setting "Search suggestions by
          # keyword" (handle: keyword, keyword; ...). The first rule with a keyword
          # in the terms wins, and only handles from the home collection list
          # count, so the list stays the one place (PRD R8).
          capture home_handles_raw
            render 'collection-handles'
          endcapture
          assign home_handles = home_handles_raw | strip | split: ','
          assign offer_collection_handle = ''
          assign offer_rules = settings.search_offer_keywords | split: ';'
          for rule in offer_rules
            assign rule_parts = rule | split: ':'
            if rule_parts.size < 2
              continue
            endif
            assign rule_handle = rule_parts[0] | strip
            unless home_handles contains rule_handle
              continue
            endunless
            assign rule_keywords = rule_parts[1] | downcase | split: ','
            for keyword in rule_keywords
              assign needle = keyword | strip
              if needle != '' and normalized_terms contains needle
                assign offer_collection_handle = rule_handle
                break
              endif
            endfor
            if offer_collection_handle != ''
              break
            endif
          endfor
          assign offer_collection = collections[offer_collection_handle]

          # Suggestions fill in ONLY when the native grid is thin (< 4 real matches),
          # capped at 3, and only when query-relevant (a query token - 4-char prefix
          # for longer tokens - appears in the product title). This is what stops a
          # 'feeding' search surfacing leashes.
          assign suggestions_cap = 3
          assign show_suggestions = false
          if product_count > 0 and product_count < 4 and offer_collection != blank and offer_collection.products_count > 0
            assign show_suggestions = true
          endif
          # Comma-wrapped stop set (matched against ',token,'). Tokens < 3 chars are dropped anyway.
          assign stop_tokens = ',pet,pets,for,the,and,with,your,'
          assign q_tokens = normalized_terms | split: ' '
        %}

        <div class="search-results-meta">
          <strong>{{ product_count }} product{% unless product_count == 1 %}s{% endunless %}</strong>
          <span>Matched from your search</span>
        </div>

        {% if product_count > 0 %}
          {%- comment -%}
            Live supplier feed (pawscout.js → /apps/pawscout/search). Ghost cards
            merge into this same grid, gated to a thin native grid (< 4) and capped
            at 3 in the JS, with the same 'Suggested' separator as Stage 1.
          {%- endcomment -%}
          <div data-pawscout-search
               data-terms="{{ search.terms | escape }}"
               data-have="{{ product_count }}"
               data-country="{{ localization.country.iso_code }}"
               data-shown-pids="">
          <div class="commerce-grid search-results-grid" data-pawscout-grid>
            {% for item in search.results %}
              {% if item.object_type == 'product' and item.available %}
                {% render 'product-card-commerce', product: item, badge: 'Search match' %}
              {% endif %}
            {% endfor %}

            {% if show_suggestions %}
              {% assign suggested_count = 0 %}
              {% capture suggestion_cards %}
                {% for offer_product in offer_collection.products %}
                  {% if suggested_count >= suggestions_cap %}{% break %}{% endif %}
                  {% liquid
                    assign offer_product_signature = ',' | append: offer_product.id | append: ','
                    assign is_duplicate_result = false
                    if result_product_ids contains offer_product_signature
                      assign is_duplicate_result = true
                    endif
                    assign title_l = offer_product.title | downcase
                    assign is_query_relevant = false
                    for tk in q_tokens
                      assign tkz = tk | strip
                      assign tklen = tkz | size
                      if tklen < 3
                        continue
                      endif
                      assign tkc = ',' | append: tkz | append: ','
                      if stop_tokens contains tkc
                        continue
                      endif
                      if tklen > 4
                        assign probe = tkz | slice: 0, 4
                      else
                        assign probe = tkz
                      endif
                      if title_l contains probe
                        assign is_query_relevant = true
                        break
                      endif
                    endfor
                  %}
                  {% if offer_product.available and is_duplicate_result == false and is_query_relevant %}
                    {% render 'product-card-commerce', product: offer_product, badge: 'Suggested' %}
                    {% assign suggested_count = suggested_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endcapture %}

              {% if suggested_count > 0 %}
                <div class="search-suggested-sep" role="separator">
                  <span>Suggested for this search · from our supplier network</span>
                </div>
                {{ suggestion_cards }}
              {% endif %}
            {% endif %}
          </div>
          </div>
        {% else %}
          <div class="search-empty">
            <strong>No product matches yet</strong>
            <span>Try a broader search like grooming, toy, feeder, bowl, leash, or cleaning.</span>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="pagination" role="navigation" aria-label="Search results pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">Previous</a>
            {% endif %}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">Next</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Main search", "settings": [] }
{% endschema %}
