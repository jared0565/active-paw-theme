<section class="category-showcase" id="shop-categories">
  <div class="category-shell">
    {% for block in section.blocks %}
      {% liquid
        assign collection_setting = block.settings.collection
        assign collection_handle = collection_setting.handle | default: collection_setting
        # The block title names the collection (its handleized form), and the
        # anchor is that handle without its first segment, so #category-cleaning.
        # No handle list lives here (PRD R8); the home template sets each
        # block's collection explicitly anyway.
        assign title_handle = block.settings.title | handleize
        assign collection_handle = collection_handle | default: title_handle
        assign anchor = title_handle | remove_first: 'pet-'
        assign collection = collections[collection_handle]
        assign visible_limit = section.settings.visible_limit
        # The cards are rendered first and counted, so the block is decided by
        # what this visitor can actually see. A market's catalogue can hold none
        # of a collection's products (PRD T19): the whole block is then left out,
        # heading and link included, so a sparse market reads as a shorter page
        # and never as a broken one. The merchant still gets the hint below, in
        # the Theme Editor only.
        assign rendered_products = 0
      %}
      {% capture block_cards %}
        {% for product in collection.products limit: section.settings.max_products %}
          <div class="{% if forloop.index > visible_limit %}is-extra-product{% endif %}">
            {% render 'product-card-commerce', product: product, badge: block.settings.badge %}
          </div>
          {% assign rendered_products = rendered_products | plus: 1 %}
        {% endfor %}
      {% endcapture %}
      {% if rendered_products > 0 or request.design_mode %}
        <section class="category-block" id="category-{{ anchor }}" {{ block.shopify_attributes }}>
          <div class="category-heading">
            <div>
              <h2>{{ block.settings.title }}</h2>
              <p>{{ block.settings.body }}</p>
            </div>
            {% if collection.url != blank and rendered_products > 0 %}
              <a class="category-view-link" href="{{ collection.url }}">View collection</a>
            {% endif %}
          </div>
          {% if rendered_products > 0 %}
            <div class="commerce-grid" data-collapsible-grid>
              {{ block_cards }}
            </div>
            {% if rendered_products > visible_limit %}
              <button class="show-more-products" type="button" data-show-more aria-expanded="false">
                <span>Show more {{ block.settings.title }}</span>
                <span aria-hidden="true">+</span>
              </button>
            {% endif %}
          {% else %}
            <div class="empty-category">
              <strong>{{ block.settings.title }}</strong>
              <span>This collection has no products for the country being previewed ({{ localization.country.name }}), so visitors there do not see this block. Add products to the collection to fill it.</span>
            </div>
          {% endif %}
        </section>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection showcase",
  "settings": [
    { "type": "range", "id": "visible_limit", "label": "Visible products before expansion", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "max_products", "label": "Maximum products rendered per collection", "min": 8, "max": 24, "step": 4, "default": 16 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collection",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pet Cleaning" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Curated picks for easy browsing and confident buying." },
        { "type": "text", "id": "badge", "label": "Product badge", "default": "Popular pick" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection showcase",
      "blocks": [
        { "type": "category" },
        { "type": "category", "settings": { "title": "Pet Accessories", "badge": "Daily use" } },
        { "type": "category", "settings": { "title": "Pet Health", "badge": "Care routine" } },
        { "type": "category", "settings": { "title": "Pet Toys", "badge": "Play pick" } }
      ]
    }
  ]
}
{% endschema %}
