{%- comment -%}
  This hero photo is the LCP element of the homepage, and it was invisible to
  the browser's preload scanner: the URL only ever reached the browser as a CSS
  custom property, so nothing could discover it until theme.css had been
  fetched, parsed and applied.

  Measured on live 2026-08-02 (mobile, 4x CPU throttle): LCP 2,701ms, of which
  2,498ms was pure load delay. TTFB was 17ms and the download itself 1ms, so
  the server and the file were never the problem - the image simply was not
  requested until 2,514ms. Chrome's LCP-discovery audit failed both
  "discoverable in initial document" and "fetchpriority=high".

  Declared HERE rather than in layout/theme.liquid on purpose: the URL stays
  next to the only element that uses it (one `assign`, so it cannot drift), and
  a preload in the shared <head> would pull 137KB on every page that does NOT
  render this hero. `rel=preload` is body-ok, and the scanner reads it from the
  raw HTML stream well before any stylesheet is applied.
{%- endcomment -%}
{%- assign hero_bg = 'pawmerce-hero-background.jpg' | asset_url -%}
{{ hero_bg | preload_tag: as: 'image' }}
<section class="hero hero-marketplace" style="--hero-bg: url('{{ hero_bg }}');">
  <div class="hero-marketplace-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.body }}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#shop-categories">{{ section.settings.primary_label }}</a>
      <a class="button button-secondary" href="{{ routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
  {% if section.settings.badge_enabled %}
    {%- comment -%}
      The seal renders these Theme Editor lines first, then theme.js repaints
      it from PawScout's storewide-event feed (running event, or the next
      planned one). See snippets/hero-event-badge.liquid for the rules.
    {%- endcomment -%}
    {% render 'hero-event-badge',
      emoji: section.settings.badge_emoji,
      line1: section.settings.badge_line1,
      line2: section.settings.badge_line2,
      link: section.settings.badge_link %}
  {% endif %}
  <div class="hero-background-spacer" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Commerce hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Happier pets, easier care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Smart Pet Finds for Grooming, Play & Walks" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Shop brushes, toys, paw care, leashes, walking gear, and everyday essentials for cleaner, happier dogs and cats." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop pet finds" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Explore best sellers" },
    { "type": "header", "content": "Event badge (seal sticker)" },
    { "type": "checkbox", "id": "badge_enabled", "label": "Show event badge", "default": true },
    { "type": "text", "id": "badge_emoji", "label": "Badge emoji", "default": "☀️🧊" },
    { "type": "text", "id": "badge_line1", "label": "Badge headline", "default": "Stay cool!" },
    { "type": "text", "id": "badge_line2", "label": "Badge subline", "default": "Shop the summer range" },
    { "type": "text", "id": "badge_link", "label": "Badge link URL", "default": "/collections/keep-them-cool", "info": "Where the badge links until an event runs; a running event links to all products. This setting is the one place for that default." }
  ],
  "presets": [{ "name": "Commerce hero" }]
}
{% endschema %}
