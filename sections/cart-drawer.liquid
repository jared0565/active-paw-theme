<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Your cart" tabindex="-1">
    <header class="cart-drawer__header">
      <h2>Your cart</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>
    <div class="cart-drawer__content" data-cart-drawer-content>
      {% render 'cart-drawer-contents' %}
    </div>
  </aside>
</div>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
