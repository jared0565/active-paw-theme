{% liquid
  assign path = request.path
  assign title = 'CoatGuard Glide 3-in-1 Shampoo + Conditioner'
  assign image = 'product-shampoo-glide.svg'
  assign price = 'GBP11.50'
  assign compare_price = 'GBP18.00'
  assign variant_label = 'Size'
  assign benefit = 'Deep-cleaning, coat-softening grooming wash for salon and home coat-care routines.'

  if path contains 'red-berry-deep-clean'
    assign title = 'Red Berry Deep Clean 25:1 Shampoo'
    assign image = 'product-shampoo-red.svg'
    assign price = 'GBP10.00'
    assign compare_price = 'GBP16.00'
    assign benefit = 'Concentrated deep-clean shampoo for high-frequency grooming and fresh coat finishes.'
  elsif path contains 'blueberry-bright'
    assign title = 'Blueberry Bright Coat Vegan Shampoo'
    assign image = 'product-shampoo-blue.svg'
    assign price = 'GBP10.00'
    assign compare_price = 'GBP16.00'
    assign benefit = 'Brightening wash positioned for dull coats, freshness, and soft salon-ready texture.'
  elsif path contains 'scissor' or path contains 'thinner'
    assign title = 'VG10 Professional Grooming Scissor'
    assign image = 'product-scissors.svg'
    assign price = 'GBP145.00'
    assign compare_price = 'GBP180.00'
    assign variant_label = 'Blade style'
    assign benefit = 'Premium grooming tool for precise finish work, shaping, and professional salon control.'
  elsif path contains 'mist' or path contains 'spray'
    assign title = 'Salon Finish Coat Mist'
    assign image = 'product-spray.svg'
    assign price = 'GBP12.00'
    assign compare_price = 'GBP18.00'
    assign benefit = 'Light finishing spray designed as a high-margin add-on for freshness and brush-through glide.'
  elsif path contains 'comb'
    assign title = 'Mat Release Grooming Comb'
    assign image = 'product-comb.svg'
    assign price = 'GBP24.00'
    assign compare_price = 'GBP32.00'
    assign variant_label = 'Tool size'
    assign benefit = 'Everyday detangling tool for grooming tables, maintenance kits, and coat-prep routines.'
  endif
%}

{% if path contains '/products/' %}
  <section class="ad-pdp">
    <div class="ad-pdp-gallery">
      <div class="ad-pdp-media">
        <img src="{{ image | asset_url }}" alt="{{ title | escape }}" width="1400" height="1050" loading="eager">
      </div>
      <div class="ad-pdp-gallery-grid">
        <img src="{{ image | asset_url }}" alt="" width="420" height="315" loading="lazy">
        <img src="{{ 'product-spray.svg' | asset_url }}" alt="" width="420" height="315" loading="lazy">
      </div>
    </div>
    <div class="ad-pdp-buybox">
      <p class="eyebrow">Campaign landing page</p>
      <h1>{{ title }}</h1>
      <div class="pdp-price-row">
        <p class="price">{{ price }}</p>
        <p class="compare-price">{{ compare_price }}</p>
        <span class="save-badge">Limited offer</span>
      </div>
      <div class="pdp-status-row">
        <span class="stock-dot">In stock</span>
        <span>★★★★★ 4.9 from 156 buyers</span>
      </div>
      <p class="pdp-lede">{{ benefit }}</p>
      <form class="demo-purchase-form">
        <label for="DemoVariant">{{ variant_label }}</label>
        <select id="DemoVariant">
          <option>Retail size</option>
          <option>Salon litre</option>
          <option>Trade refill</option>
        </select>
        <label for="DemoQty">Quantity</label>
        <div class="quantity-control">
          <button type="button" data-quantity-change="-1" aria-label="Decrease quantity">-</button>
          <input id="DemoQty" type="number" value="1" min="1" inputmode="numeric">
          <button type="button" data-quantity-change="1" aria-label="Increase quantity">+</button>
        </div>
        <button class="button button-primary full pdp-atc" type="button">Add to cart</button>
      </form>
      <div class="bundle-builder">
        <div class="bundle-builder-head">
          <div>
            <span class="save-badge">Bundle & save</span>
            <h2>Complete grooming routine</h2>
            <p>{{ title }} + finishing mist + detangling comb</p>
          </div>
          <div class="bundle-price">
            <span>GBP49.00</span>
            <strong>GBP39.00</strong>
          </div>
        </div>
        <div class="bundle-items">
          <label><input type="checkbox" checked> Main product</label>
          <label><input type="checkbox" checked> Salon finishing mist</label>
          <label><input type="checkbox" checked> Mat release comb</label>
        </div>
        <button class="button button-secondary bundle-cta" type="button">Add discounted bundle</button>
      </div>
      <div class="pdp-proof-strip ad-pdp-proof">
        <div><strong>Free shipping threshold</strong><span>Increase AOV with cart progress.</span></div>
        <div><strong>100% satisfaction promise</strong><span>Reduce first-purchase risk.</span></div>
        <div><strong>Secure checkout</strong><span>Cards, PayPal, and Shop Pay ready.</span></div>
      </div>
    </div>
  </section>
  <section class="pdp-detail-stack">
    <div class="section-heading">
      <p class="eyebrow">Built for paid traffic</p>
      <h2>Everything the buyer needs before clicking add to cart</h2>
      <p>This landing page pattern keeps product proof, offer clarity, bundle economics, delivery confidence, and usage guidance in one focused path.</p>
    </div>
    <div class="pdp-info-grid">
      <article><span>01</span><h3>Outcome-led copy</h3><p>Shows the buyer what improves after purchase.</p></article>
      <article><span>02</span><h3>Variant clarity</h3><p>Retail, salon, and trade options support different buyer intents.</p></article>
      <article><span>03</span><h3>Bundle lift</h3><p>Discounted routine raises basket value without adding friction.</p></article>
      <article><span>04</span><h3>Trust near CTA</h3><p>Shipping, reviews, guarantees, and secure payment reduce hesitation.</p></article>
    </div>
  </section>
{% else %}
  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The page you were looking for does not exist.</p>
      <a class="button button-primary" href="{{ routes.root_url }}">Back to store</a>
    </div>
  </section>
{% endif %}

{% schema %}
{ "name": "Demo product fallback", "settings": [] }
{% endschema %}
