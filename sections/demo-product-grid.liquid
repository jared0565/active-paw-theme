<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Merchandising system</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
  </div>
  <div class="product-grid">
    {% render 'demo-product-card', title: 'Pet Toothbrush Oral Cleaning Products', price: 'From GBP4.99', rating: '5.0', tag: 'Dental care', image: 'product-comb.svg', url: '/products/pet-toothbrush-oral-cleaning-products' %}
    {% render 'demo-product-card', title: 'Pet Dog Foot Care Cleaning Products Silicone', price: 'From GBP9.99', rating: '4.8', tag: 'Paw care', image: 'product-shampoo-blue.svg', url: '/products/pet-dog-foot-care-cleaning-products-silicone' %}
    {% render 'demo-product-card', title: 'Dog Running Harness', price: 'From GBP14.99', rating: '4.9', tag: 'Walking gear', image: 'product-scissors.svg', url: '/products/dog-running-harness' %}
    {% render 'demo-product-card', title: 'Pet Bath Shampoo Dog Grooming Products', price: 'GBP6.99', rating: '4.7', tag: 'Grooming', image: 'product-shampoo-glide.svg', url: '/products/pet-bath-shampoo-dog-grooming-products' %}
    {% render 'demo-product-card', title: 'Pet Automatic Telescopic Traction Rope', price: 'From GBP6.99', rating: '4.8', tag: 'Best seller', image: 'product-spray.svg', url: '/products/pet-automatic-telescopic-traction-rope' %}
    {% render 'demo-product-card', title: 'Reflective Dog Leash Nylon Training Rope', price: 'From GBP6.99', rating: '4.9', tag: 'Training', image: 'product-comb.svg', url: '/products/reflective-dog-leash-nylon-pet-dog-leash-rope-for-small-medium-large-dogs-walking-training-pet-suppiles' %}
  </div>
</section>

{% schema %}
{
  "name": "Demo product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers for busy groomers" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Demo products based on public grooming collections, rewritten for a reusable proposal theme." }
  ],
  "presets": [{ "name": "Demo product grid" }]
}
{% endschema %}
