{%- comment -%}
  Affiliates page entry point (PRD T10, owner decision 5c, 2026-09-19).

  The programme copy lives in the page body, edited by the owner in admin.
  This section adds the two routes into the programme:
  - the Apply button to the worker's form (/apps/pawscout/affiliate/apply).
    It ships hidden and theme.js shows it only once the storewide event feed
    has answered, which proves the worker is reachable; with the worker down
    the page stays complete and the button never appears (contract rule 1).
  - the email route, which works whether or not the worker is up.

  Rendered only by templates/page.affiliates.json; the owner assigns that
  template to the Affiliates page.
{%- endcomment -%}
<section class="section affiliate-apply">
  <div class="affiliate-apply__card">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="affiliate-apply__actions">
      <a class="button button-primary" data-affiliate-apply hidden href="{{ section.settings.apply_url }}">{{ section.settings.button_label }}</a>
      <a class="button button-secondary" href="mailto:{{ section.settings.email }}?subject={{ section.settings.email_subject | url_encode }}">Email {{ section.settings.email }}</a>
    </div>
    {%- if section.settings.offline_note != blank -%}
      <p class="affiliate-apply__note" data-affiliate-apply-note>{{ section.settings.offline_note }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  .affiliate-apply__card { max-width: 760px; padding: 24px; border-radius: 16px; background: var(--surface); color: var(--ink); }
  .affiliate-apply__card h2 { margin: 0 0 8px; font-size: 22px; }
  .affiliate-apply__card p { margin: 0 0 16px; color: var(--muted); line-height: 1.6; }
  .affiliate-apply__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
  .affiliate-apply__note { font-size: 14px; }
{% endstyle %}

{% schema %}
{
  "name": "Affiliate apply",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to apply?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us about your channel and how you would promote Active Paw. Applications are reviewed by email." },
    { "type": "text", "id": "button_label", "label": "Apply button label", "default": "Apply online" },
    { "type": "text", "id": "apply_url", "label": "Apply form URL", "default": "/apps/pawscout/affiliate/apply", "info": "The partner desk's form. The button shows only while that service answers." },
    { "type": "text", "id": "email", "label": "Email route", "default": "sales@activepaw.co.uk" },
    { "type": "text", "id": "email_subject", "label": "Email subject", "default": "Partner programme application" },
    { "type": "text", "id": "offline_note", "label": "Note shown while the online form is unavailable", "default": "The online form opens when our partner desk is available. Email works at any time." }
  ]
}
{% endschema %}
