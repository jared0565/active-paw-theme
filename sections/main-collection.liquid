<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Collection</p>
    <h1>{{ collection.title | default: 'Our products' }}</h1>
    {%- comment -%} A div, not a p: the description is the merchant's HTML from the store admin
        and brings its own paragraphs, which a p cannot contain (the browser closed the p
        early and left two empty ones). The hook lets the independence run tell the
        merchant's words from the theme's. {%- endcomment -%}
    {% if collection.description != blank %}
      <div class="collection-description" data-collection-description>{{ collection.description }}</div>
    {% else %}
      <p>Browse the full range of everyday pet-care picks.</p>
    {% endif %}
  </div>
  {% paginate collection.products by 12 %}
    {%- comment -%}
      Decided by the products on this page, so neither a collection that is
      empty for the visitor's market (PRD T19) nor a page number past the end
      renders an empty grid. Every count Liquid offers is scoped to the market
      (measured 2026-09-20), so "empty here" and "empty everywhere" cannot be
      told apart; the message is worded to be true in both cases.
    {%- endcomment -%}
    {% if collection.products.size > 0 %}
      <div class="commerce-grid">
        {% for product in collection.products %}
          {% render 'product-card-commerce', product: product, badge: collection.title %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav class="pagination" role="navigation" aria-label="Collection pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <div class="empty-category">
        <strong>Nothing available here right now</strong>
        {% if collection.url == routes.all_products_collection_url %}
          <span>No products are available for your delivery country ({{ localization.country.name }}) at the moment.</span>
        {% else %}
          <span>No products from {{ collection.title }} are available for your delivery country ({{ localization.country.name }}) at the moment.</span>
          <a class="button button-primary" href="{{ routes.all_products_collection_url }}">Browse all products</a>
        {% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{ "name": "Main collection", "settings": [] }
{% endschema %}
