{% doc %}
  Social share row for the PDP. Plain intent/share links — no third-party
  scripts, no trackers. Native device share is covered by the existing
  top-row share button (theme.js); this row adds the network links + copy.
  Link previews are handled by snippets/meta-tags.liquid (og:*) + Shopify's
  auto-injected og:image.
  @param {product} product - Product being shared
{% enddoc %}

{%- liquid
  assign share_url = shop.url | append: product.url
  assign share_text = product.title | escape
  assign share_image = product.featured_image | image_url: width: 1200
-%}

{%- comment -%} NB: root must not carry data-share-url — theme.js click-delegates on it. {%- endcomment -%}
<div class="social-share" data-social-share data-ss-url="{{ share_url }}" data-ss-title="{{ share_text }}">
  <span class="social-share__label">Share</span>
  <a class="social-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.87.24-1.46 1.49-1.46h1.4V5.07A19 19 0 0 0 14.34 5C12.06 5 10.5 6.39 10.5 8.95V11H8.1v3h2.4v7Z" fill="currentColor"/></svg>
    Facebook
  </a>
  <a class="social-share__btn" href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ share_text | url_encode }}" target="_blank" rel="noopener" aria-label="Share on X">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.5 21h-6l-4.1-5.4L6.7 21h-3l7-8L3.5 3h6.1l3.7 4.9L17.5 3Zm-1 16h1.6L8.4 4.7H6.6L16.5 19Z" fill="currentColor"/></svg>
    X
  </a>
  <a class="social-share__btn" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ share_image | url_encode }}&description={{ share_text | url_encode }}" target="_blank" rel="noopener" aria-label="Pin on Pinterest">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.05-.74-.1-1.88.02-2.7l1.18-5s-.3-.6-.3-1.49c0-1.4.81-2.44 1.82-2.44.86 0 1.27.64 1.27 1.41 0 .86-.55 2.15-.83 3.34-.24 1 .5 1.81 1.48 1.81 1.78 0 3.15-1.88 3.15-4.59 0-2.4-1.72-4.08-4.19-4.08-2.85 0-4.53 2.14-4.53 4.35 0 .86.33 1.79.75 2.29a.3.3 0 0 1 .07.29l-.28 1.13c-.04.18-.15.22-.34.13-1.26-.58-2.04-2.42-2.04-3.9 0-3.17 2.31-6.08 6.65-6.08 3.49 0 6.2 2.49 6.2 5.81 0 3.47-2.19 6.26-5.22 6.26-1.02 0-1.98-.53-2.3-1.16l-.63 2.39c-.23.87-.84 1.97-1.25 2.64A9 9 0 1 0 12 3Z" fill="currentColor"/></svg>
    Pinterest
  </a>
  <a class="social-share__btn" href="https://wa.me/?text={{ share_text | url_encode }}%20{{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.65-1.16A9 9 0 1 0 12 3Zm0 1.8a7.2 7.2 0 1 1-3.66 13.4l-.26-.16-2.76.69.71-2.68-.17-.28A7.2 7.2 0 0 1 12 4.8Zm-2.4 3.3c-.2 0-.5.07-.76.36-.26.28-1 .97-1 2.37 0 1.4 1.02 2.76 1.16 2.95.14.19 2 3.05 4.86 4.15 2.38.92 2.87.74 3.39.69.52-.05 1.66-.68 1.9-1.33.23-.66.23-1.22.16-1.33-.07-.12-.26-.19-.54-.33-.28-.14-1.66-.82-1.92-.91-.26-.1-.45-.14-.63.14-.19.28-.73.9-.89 1.09-.16.19-.33.21-.61.07a7.74 7.74 0 0 1-2.26-1.4 8.46 8.46 0 0 1-1.57-1.95c-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.16.19-.28.28-.47.1-.19.05-.35-.02-.5-.07-.14-.62-1.52-.86-2.08-.22-.55-.45-.47-.62-.48Z" fill="currentColor"/></svg>
    WhatsApp
  </a>
  <a class="social-share__btn" href="mailto:?subject={{ share_text | url_encode }}&body={{ share_url | url_encode }}" aria-label="Share by email">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 5h18v14H3V5Zm2 2v.35l7 4.6 7-4.6V7H5Zm14 2.74-7 4.6-7-4.6V17h14V9.74Z" fill="currentColor"/></svg>
    Email
  </a>
  <button type="button" class="social-share__btn" data-share-copy aria-label="Copy product link">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 9h10v12H9V9Zm2 2v8h6v-8h-6ZM5 3h10v4h-2V5H7v10h2v2H5V3Z" fill="currentColor"/></svg>
    <span data-share-copy-label>Copy link</span>
  </button>
  <button type="button" class="social-share__btn" data-share-qr-toggle aria-expanded="false" aria-controls="ShareQrPanel" aria-label="Show a QR code to scan">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 3h8v8H3V3Zm2 2v4h4V5H5Zm8-2h8v8h-8V3Zm2 2v4h4V5h-4ZM3 13h8v8H3v-8Zm2 2v4h4v-4H5Zm10-2h2v2h-2v-2Zm4 0h2v2h-2v-2Zm-4 4h2v2h-2v-2Zm2 2h2v2h-2v-2Zm2-2h2v2h-2v-2Z" fill="currentColor"/></svg>
    QR code
  </button>
  <div class="social-share__qr" id="ShareQrPanel" data-share-qr hidden>
    <img class="social-share__qr-img" alt="QR code that links to this page" data-share-qr-img width="200" height="200" loading="lazy">
    <p class="social-share__qr-hint">Scan with a phone camera to open this page.</p>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-social-share]');
    if (!root) return;
    var url = root.getAttribute('data-ss-url');
    var copy = root.querySelector('[data-share-copy]');
    if (copy) {
      copy.addEventListener('click', function () {
        var label = copy.querySelector('[data-share-copy-label]');
        (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
          .then(function () { if (label) label.textContent = 'Copied!'; })
          .catch(function () { window.prompt('Copy this link:', url); })
          .finally(function () {
            setTimeout(function () { if (label) label.textContent = 'Copy link'; }, 2000);
          });
      });
    }

    var qrToggle = root.querySelector('[data-share-qr-toggle]');
    var qrPanel = root.querySelector('[data-share-qr]');
    var qrImg = root.querySelector('[data-share-qr-img]');
    if (qrToggle && qrPanel && qrImg) {
      qrToggle.addEventListener('click', function () {
        var opening = qrPanel.hasAttribute('hidden');
        if (opening) {
          // Lazy-build the QR only on first open. Encodes this page's public URL via a
          // QR image service; if it ever fails, the network links + Copy still work.
          if (!qrImg.getAttribute('src')) {
            qrImg.setAttribute('src', 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=' + encodeURIComponent(url));
          }
          qrPanel.removeAttribute('hidden');
          qrToggle.setAttribute('aria-expanded', 'true');
        } else {
          qrPanel.setAttribute('hidden', '');
          qrToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
