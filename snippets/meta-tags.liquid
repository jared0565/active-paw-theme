{%- comment -%}
  Social meta + structured data.

  Shopify auto-injects og:image (+ secure_url/width/height) via content_for_header
  for every page type, using the admin "social sharing image" preference. It does NOT
  inject og:title/type/url/description, og:site_name/locale, or any twitter:* tags, nor
  any JSON-LD. This snippet supplies those gaps, plus platform-optimised share
  images for products and collections: scrapers prefer the FIRST suitable
  og:image and this snippet renders before content_for_header, so the 1200x630
  crop (Facebook/LinkedIn/X card shape) wins, the 1200x1200 square (WhatsApp/
  Telegram thumbnails) is the alternate, and Shopify's auto image remains a
  final fallback. Pages without their own image keep only Shopify's.

  Rendered once from layout/theme.liquid <head>.
{%- endcomment -%}

{%- liquid
  assign brand_name = settings.demo_brand_name | default: 'Active Paw'
  assign meta_title = page_title | default: brand_name | replace: 'Pawmerce', brand_name
  assign meta_description = page_description | default: shop.description | default: shop.name | replace: 'Pawmerce', brand_name
  assign meta_url = canonical_url | default: request.origin

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}

<meta property="og:site_name" content="{{ brand_name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:url" content="{{ meta_url }}">
{%- if meta_description != blank %}
<meta property="og:description" content="{{ meta_description | escape }}">
{%- endif %}
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- comment -%} Platform-optimised share images (products/collections). {%- endcomment -%}
{%- assign share_image = blank -%}
{%- if request.page_type == 'product' and product.featured_media -%}
  {%- assign share_image = product.featured_media -%}
{%- elsif request.page_type == 'collection' and collection.image -%}
  {%- assign share_image = collection.image -%}
{%- elsif request.page_type == 'article' and article.image -%}
  {%- assign share_image = article.image -%}
{%- endif -%}
{%- if share_image != blank -%}
  {%- assign share_img_wide = share_image | image_url: width: 1200, height: 630, crop: 'center' | prepend: 'https:' -%}
  {%- assign share_img_square = share_image | image_url: width: 1200, height: 1200, crop: 'center' | prepend: 'https:' -%}
  {%- assign share_img_alt = share_image.alt | default: meta_title -%}
<meta property="og:image" content="{{ share_img_wide }}">
<meta property="og:image:secure_url" content="{{ share_img_wide }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ share_img_alt | escape }}">
<meta property="og:image" content="{{ share_img_square }}">
<meta property="og:image:secure_url" content="{{ share_img_square }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="1200">
<meta property="og:image:alt" content="{{ share_img_alt | escape }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta_title | escape }}">
{%- if meta_description != blank %}
<meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif %}
{%- if share_image != blank %}
<meta name="twitter:image" content="{{ share_img_wide }}">
<meta name="twitter:image:alt" content="{{ share_img_alt | escape }}">
{%- endif %}

{%- comment -%} ---- Organization + WebSite (every page) ---- {%- endcomment -%}
{%- if settings.brand_logo != blank -%}
  {%- assign org_logo = settings.brand_logo | image_url: width: 400 | prepend: 'https:' -%}
{%- else -%}
  {%- comment -%} Raster beats SVG here: Google's Organization logo parser wants a PNG/JPG at 112px+. {%- endcomment -%}
  {%- assign org_logo = 'active-paw-app-icon-512.png' | asset_url -%}
  {%- assign org_logo = org_logo | prepend: 'https:' -%}
{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ brand_name | json }},
  "url": {{ request.origin | json }},
  "logo": {{ org_logo | json }}
}
</script>
{%- comment -%} Built via capture so the {search_term_string} braces stay literal text (they break Liquid's {{ }} parser). {%- endcomment -%}
{%- capture search_target -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ brand_name | json }},
  "url": {{ request.origin | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ search_target | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%} ---- Product (PDP only) - no aggregateRating: ratings are not yet from a real source ---- {%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
  {%- assign product_currency = cart.currency.iso_code | default: shop.currency -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if product.featured_media %}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  {% if product.description != blank %}"description": {{ product.description | strip_html | truncatewords: 60 | json }},{% endif %}
  {% if product.vendor != blank %}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{% endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ product_currency | json }},
      "url": {{ request.origin | append: variant.url | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
  {%- comment -%} Breadcrumb: Home > (first collection) > Product {%- endcomment -%}
  {%- assign crumb_collection = product.collections.first -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }{% if crumb_collection %},
    { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ request.origin | append: crumb_collection.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }{% else %},
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }{% endif %}
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
  ]
}
</script>
{%- endif -%}

{%- comment -%} ---- Article (blog post only) ---- {%- endcomment -%}
{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "url": {{ request.origin | append: article.url | json }},
  "mainEntityOfPage": {{ request.origin | append: article.url | json }},
  {% if article.image %}"image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  {% if article.excerpt_or_content != blank %}"description": {{ article.excerpt_or_content | strip_html | truncatewords: 60 | json }},{% endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Organization", "name": {% if article.author != blank %}{{ article.author | json }}{% else %}{{ brand_name | json }}{% endif %} },
  "publisher": { "@type": "Organization", "name": {{ brand_name | json }}, "logo": { "@type": "ImageObject", "url": {{ org_logo | json }} } }
}
</script>
  {%- comment -%} Breadcrumb: Home > Blog > Article {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }{% if blog %},
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }{% else %},
    { "@type": "ListItem", "position": 2, "name": {{ article.title | json }} }{% endif %}
  ]
}
</script>
{%- endif -%}
