{%- comment -%}
  Add-to-Home-Screen prompt. Both blocks start hidden; theme.js reveals the
  pill only when installation is genuinely possible on the visitor's browser
  (a captured beforeinstallprompt on Android/Chrome/Edge, or the share-menu
  path on iOS), never in the same page view as the welcome offer modal, and
  a dismissal sleeps it for 30 days. The footer button (site-footer.liquid)
  reuses the same handlers as an always-available, visitor-initiated path.
{%- endcomment -%}
{%- assign brand_name = settings.demo_brand_name | default: 'Active Paw' -%}

<div class="install-pill" data-install-pill hidden>
  <img class="install-pill__icon" src="{{ 'active-paw-app-icon-192.png' | asset_url }}" alt="" width="44" height="44" loading="lazy">
  <div class="install-pill__copy">
    <strong>Add {{ brand_name }} to your Home Screen</strong>
    <span>Opens full screen, one tap away. No app store needed.</span>
  </div>
  <button type="button" class="install-pill__cta" data-install-accept>Add</button>
  <button type="button" class="install-pill__dismiss" data-install-dismiss aria-label="Not now">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<div class="install-pill install-pill--steps" data-install-steps hidden>
  <div class="install-pill__steps-head">
    <img class="install-pill__icon" src="{{ 'active-paw-app-icon-192.png' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <strong>Add {{ brand_name }} to your Home Screen</strong>
  </div>
  <ol class="install-pill__steps">
    <li>
      Tap the <strong>Share</strong> button
      <svg class="install-pill__share-glyph" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 3v12M8 6l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 10H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1h-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      in your browser toolbar.
    </li>
    <li>Scroll the menu and choose <strong>Add to Home Screen</strong>.</li>
  </ol>
  <button type="button" class="install-pill__cta install-pill__cta--wide" data-install-steps-close>Got it</button>
</div>
