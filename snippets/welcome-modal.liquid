{%- comment -%}
  Welcome offer modal - the reusable event slot for first-order promotions,
  settings-driven like the hero event badge (Theme settings > Welcome offer).
  Renders only while the offer is enabled; theme.js decides when to show it
  (once per browser, after 3 seconds or the first scroll, never instantly)
  and routes every CTA through /discount/<code> so the offer is already
  applied when the visitor reaches checkout.
  Honesty rules: the only urgency line is the event's REAL end date - no
  counters, no invented scarcity. Skipped entirely for logged-in customers
  who have ordered before, because the discount is for first orders and they
  would be shown an offer they cannot use.
  SELF-TEARING + EVENT SLOT (2026-07-06): the shell ALWAYS renders while the
  master toggle is on (an Events-view activation must be able to wake it long
  after the fallback offer expired), but it only OPENS when an event is live:
  (1) the end date rendered below gates the fallback content client-side, and
  (2) theme.js asks PawScout (/public/event) which storewide event is REALLY
  running - the Shopify discount is the source of truth - then repaints the
  headline, wording, chips, code and end date from that event, or keeps the
  modal closed when there is none. A network failure leaves the date-gated
  fallback in charge. Dismissals are remembered PER CODE, so closing one
  event's offer never hides the next event.
{%- endcomment -%}
{%- if settings.welcome_enabled -%}
  {%- unless customer and customer.orders_count > 0 -%}
<div class="contact-modal welcome-modal" data-welcome-modal aria-hidden="true"
     data-welcome-code="{{ settings.welcome_code | default: 'WELCOME10' | escape }}"
     data-welcome-until="{{ settings.welcome_ends_date | escape }}"
     data-welcome-event-src="https://pawscout.activepaw.co.uk/public/event"
     data-welcome-redirect="{{ settings.welcome_redirect | default: '/collections/all' | escape }}">
  <div class="contact-modal__overlay" data-welcome-close></div>
  <div class="contact-modal__dialog welcome-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="WelcomeModalTitle" tabindex="-1">
    <button type="button" class="contact-modal__close welcome-modal__close" data-welcome-close aria-label="Close welcome offer">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
    <p class="welcome-modal__eyebrow">Welcome to {{ settings.demo_brand_name | default: 'Active Paw' }}</p>
    <h2 id="WelcomeModalTitle">{{ settings.welcome_headline | default: '10% off your first order' }}</h2>
    <p class="welcome-modal__sub">{{ settings.welcome_subline | default: 'On top of free UK delivery on every order.' }}</p>
    <p class="welcome-modal__code">Your code: <strong>{{ settings.welcome_code | default: 'WELCOME10' }}</strong> <span>applied automatically when you shop from here</span></p>
    <form class="welcome-modal__search" data-welcome-search>
      <label class="visually-hidden" for="WelcomeSearchInput">Search products</label>
      <input id="WelcomeSearchInput" data-welcome-input type="search" placeholder="What does your pet need?" autocomplete="off">
      <button type="submit">Search</button>
    </form>
    {%- assign welcome_chip_list = settings.welcome_chips | default: 'Cat trees, Cooling mats, Litter boxes, Dog beds' | split: ',' -%}
    <div class="welcome-modal__chips">
      {%- for chip in welcome_chip_list -%}
        {%- assign chip_clean = chip | strip -%}
        {%- if chip_clean != blank -%}
        <button type="button" data-welcome-chip="{{ chip_clean | escape }}">{{ chip_clean }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <a class="welcome-modal__browse" data-welcome-browse
       href="/discount/{{ settings.welcome_code | default: 'WELCOME10' | url_encode }}?redirect={{ settings.welcome_redirect | default: '/collections/all' | url_encode }}">
      {{ settings.welcome_cta | default: 'Start shopping with the offer applied' }}
    </a>
    {%- assign wm_ends_label = settings.welcome_ends -%}
    {%- if settings.welcome_ends_date != blank -%}
      {%- assign wm_ends_label = settings.welcome_ends_date | date: 'Ends %-d %B' -%}
    {%- endif -%}
    {%- if wm_ends_label != blank -%}
    <p class="welcome-modal__ends">{{ wm_ends_label }}</p>
    {%- endif -%}
    <button type="button" class="welcome-modal__later" data-welcome-close>Maybe later</button>
  </div>
</div>
  {%- endunless -%}
{%- endif -%}
