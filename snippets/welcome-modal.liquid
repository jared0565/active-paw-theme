{%- comment -%}
  Welcome offer modal - the storewide event slot for first-order promotions.
  theme.js decides when to show it (once per browser per event, after 3
  seconds or the first scroll, never instantly) and routes every CTA through
  /discount/<code> so the offer is already applied when the visitor reaches
  checkout. Skipped entirely for logged-in customers who have ordered before,
  because the discount is for first orders and they would be shown an offer
  they cannot use.
  FEED-DRIVEN ONLY (2026-09-18): the shell renders while the master toggle
  is on, but it carries no offer of its own - no code, no percentage, no end
  date. theme.js asks PawScout (/public/event, ONE fetch shared with the hero
  badge and the announcement bar) which storewide event is REALLY running -
  the Shopify discount is the source of truth - and paints the headline,
  wording, chips, code, link and end line from that answer. If the feed is
  unreachable or reports nothing running, the modal never opens. The former
  settings fallback (a welcome code that ended 19 July 2026) kept rendering
  after its event was over, which is why there is no fallback any more.
  Honesty rules: the only urgency line is the event's REAL end date - no
  counters, no invented scarcity. Dismissals are remembered PER CODE, so
  closing one event's offer never hides the next event.
{%- endcomment -%}
{%- assign welcome_redirect = settings.welcome_redirect | default: routes.all_products_collection_url -%}
{%- if settings.welcome_enabled -%}
  {%- unless customer and customer.orders_count > 0 -%}
<div class="contact-modal welcome-modal" data-welcome-modal aria-hidden="true"
     data-welcome-code=""
     data-welcome-redirect="{{ welcome_redirect | escape }}">
  <div class="contact-modal__overlay" data-welcome-close></div>
  <div class="contact-modal__dialog welcome-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="WelcomeModalTitle" tabindex="-1">
    <button type="button" class="contact-modal__close welcome-modal__close" data-welcome-close aria-label="Close welcome offer">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
    <p class="welcome-modal__eyebrow">Welcome to {{ settings.demo_brand_name | default: 'Active Paw' }}</p>
    {%- comment -%} Headline, supporting line, code and end line are painted by theme.js from the live event. {%- endcomment -%}
    <h2 id="WelcomeModalTitle"></h2>
    <p class="welcome-modal__sub" hidden></p>
    <p class="welcome-modal__code">Your code: <strong></strong> <span>applied automatically when you shop from here</span></p>
    <form class="welcome-modal__search" data-welcome-search>
      <label class="visually-hidden" for="WelcomeSearchInput">Search products</label>
      <input id="WelcomeSearchInput" data-welcome-input type="search" placeholder="What does your pet need?" autocomplete="off">
      <button type="submit">Search</button>
    </form>
    {%- assign welcome_chip_list = settings.welcome_chips | default: 'Cat trees, Cooling mats, Litter boxes, Dog beds' | split: ',' -%}
    <div class="welcome-modal__chips">
      {%- for chip in welcome_chip_list -%}
        {%- assign chip_clean = chip | strip -%}
        {%- if chip_clean != blank -%}
        <button type="button" data-welcome-chip="{{ chip_clean | escape }}">{{ chip_clean }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <a class="welcome-modal__browse" data-welcome-browse
       href="{{ welcome_redirect | escape }}">
      {{ settings.welcome_cta | default: 'Start shopping with the offer applied' }}
    </a>
    <button type="button" class="welcome-modal__later" data-welcome-close>Maybe later</button>
  </div>
</div>
  {%- endunless -%}
{%- endif -%}
