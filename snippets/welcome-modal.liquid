{%- comment -%}
  Event offer modal: the storewide event's code, offered once per browser per
  event. theme.js decides when to show it (after 3 seconds or the first scroll,
  never instantly, never while Shopify's cookie banner waits for an answer)
  and routes every way out that offers the code through /discount/<code>, so
  the code is applied as part of that navigation.
  FEED-DRIVEN ONLY (2026-09-18): the shell renders while the master toggle
  is on, but it carries no offer of its own - no code, no percentage, no end
  date. theme.js asks PawScout (/public/event, ONE fetch shared with the hero
  seal and the announcement bar) which storewide event is REALLY running -
  the Shopify discount is the source of truth - and paints the event name,
  headline, wording, chips, code, link and end line from that answer. If the
  feed is unreachable or reports nothing running, the modal never opens.
  Every customer sees it, those who have ordered before included (owner
  decision 2026-11-14, PRD T29): the worker reports an event as running only
  for a discount open to all buyers (docs/theme-worker-contract.md §3). The
  eyebrow is the brand until theme.js puts the event's name there.
  data-welcome-used-codes lists the discount codes a logged-in customer's
  orders used (the first page Shopify returns, up to 20 orders), so a
  once-per-customer code they already used is not offered to them again. A
  guest's list is empty: Shopify identifies a guest at checkout by email,
  which the storefront does not know.
  Honesty rules: the only urgency line is the event's REAL end time - no
  counters, no invented scarcity. Dismissals are remembered PER CODE, so
  closing one event's offer never hides the next event.
{%- endcomment -%}
{%- assign welcome_redirect = settings.welcome_redirect | default: routes.all_products_collection_url -%}
{%- if settings.welcome_enabled -%}
  {%- liquid
    assign welcome_used_codes = ''
    if customer
      for order in customer.orders limit: 20
        for application in order.discount_applications
          if application.type == 'discount_code'
            assign welcome_used_codes = welcome_used_codes | append: ',' | append: application.title
          endif
        endfor
      endfor
    endif
  -%}
<div class="contact-modal welcome-modal" data-welcome-modal aria-hidden="true"
     data-welcome-code=""
     data-welcome-used-codes="{{ welcome_used_codes | upcase | escape }}"
     data-welcome-redirect="{{ welcome_redirect | escape }}">
  <div class="contact-modal__overlay" data-welcome-close></div>
  <div class="contact-modal__dialog welcome-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="WelcomeModalTitle" tabindex="-1">
    <button type="button" class="contact-modal__close welcome-modal__close" data-welcome-close aria-label="Close offer">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </button>
    <p class="welcome-modal__eyebrow" data-welcome-eyebrow>{{ settings.demo_brand_name | default: 'Active Paw' }}</p>
    {%- comment -%} Headline, supporting line, code and end line are painted by theme.js from the live event. {%- endcomment -%}
    <h2 id="WelcomeModalTitle"></h2>
    <p class="welcome-modal__sub" hidden></p>
    <p class="welcome-modal__code">Your code: <strong></strong> <span>applied automatically when you shop from here</span></p>
    <form class="welcome-modal__search" data-welcome-search>
      <label class="visually-hidden" for="WelcomeSearchInput">Search products</label>
      <input id="WelcomeSearchInput" data-welcome-input type="search" placeholder="What does your pet need?" autocomplete="off">
      <button type="submit">Search</button>
    </form>
    {%- comment -%} Evergreen search shortcuts; each found matching products on live search (2026-11-14). {%- endcomment -%}
    {%- assign welcome_chip_list = settings.welcome_chips | default: 'Grooming, Teeth cleaning, Cat toys, Litter boxes' | split: ',' -%}
    <div class="welcome-modal__chips">
      {%- for chip in welcome_chip_list -%}
        {%- assign chip_clean = chip | strip -%}
        {%- if chip_clean != blank -%}
        <button type="button" data-welcome-chip="{{ chip_clean | escape }}">{{ chip_clean }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <a class="welcome-modal__browse" data-welcome-browse
       href="{{ welcome_redirect | escape }}">
      {{ settings.welcome_cta | default: 'Start shopping with the offer applied' }}
    </a>
    <button type="button" class="welcome-modal__later" data-welcome-close>Maybe later</button>
  </div>
</div>
{%- endif -%}
