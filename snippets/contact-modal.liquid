{%- comment -%}
  Contact Us modal — wraps Shopify's native {% form 'contact' %} (emails the store's
  contact address; no app/backend needed). The form does a full-page POST and Shopify
  redirects back with form.posted_successfully? / form.errors set. We render that result
  inside [data-contact-result]; theme.js auto-opens the modal on load when it's present.
{%- endcomment -%}
<div class="contact-modal" data-contact-modal aria-hidden="true">
  <div class="contact-modal__overlay" data-contact-close></div>
  <div class="contact-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ContactModalTitle" tabindex="-1">
    <header class="contact-modal__head">
      <div>
        <h2 id="ContactModalTitle">Contact us</h2>
        <p>Questions about products, orders, or grooming picks? Send us a message.</p>
      </div>
      <button type="button" class="contact-modal__close" data-contact-close aria-label="Close contact form">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        {%- comment -%} data-contact-result is required: theme.js auto-opens the modal when it finds it. {%- endcomment -%}
        <div class="contact-form__result contact-confirm" data-contact-result role="status">
          <span class="contact-confirm__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34" focusable="false"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3>Message sent — thank you!</h3>
          <p>We usually reply within <strong>{{ settings.contact_reply_eta | default: '24 hours' }}</strong> (often sooner) to the email you gave us.</p>
          <p class="contact-confirm__spam">Can't find our reply? Please check your <strong>spam</strong> or <strong>junk</strong> folder, and add us to your contacts so future messages reach your inbox.</p>
          <button type="button" class="button button-primary full" data-contact-close>Close</button>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="contact-form__result contact-form__result--error" data-contact-result role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form__field">
          <label for="ContactName">Name <span aria-hidden="true">*</span></label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
        </div>
        <div class="contact-form__field">
          <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required>
        </div>
        <div class="contact-form__field">
          <label for="ContactPhone">Phone <span class="contact-form__optional">(optional)</span></label>
          <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
        </div>
        <div class="contact-form__field">
          <label for="ContactBody">Message <span aria-hidden="true">*</span></label>
          <textarea id="ContactBody" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea>
        </div>
        <button type="submit" class="button button-primary full">Send message</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
