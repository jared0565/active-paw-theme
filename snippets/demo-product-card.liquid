{% doc %}
Renders a fictitious proposal product card for the reusable theme prototype.
@param {string} title - Product title
@param {string} price - Product price label
@param {string} rating - Product rating label
@param {string} tag - Product merchandising tag
@param {string} image - Product image URL
@param {string} url - Product detail URL
{% enddoc %}

<article class="product-card">
  <a class="product-card-link" href="{{ url | default: '/products/coatguard-glide-3-in-1-shampoo-conditioner' }}" aria-label="View {{ title | escape }}">
    <div class="product-media">
      {% if image != blank %}
        <img src="{{ image | asset_url }}" alt="{{ title | escape }}" width="900" height="675" loading="lazy">
      {% endif %}
      <span>{{ tag }}</span>
    </div>
    <div class="product-card-body">
      <p class="rating">★★★★★ {{ rating }}</p>
      <h3>{{ title }}</h3>
      <p class="price">{{ price }}</p>
      <div class="card-meta-row">
        <span>Variants + bundle details</span>
        <strong>View product</strong>
      </div>
    </div>
  </a>
</article>
