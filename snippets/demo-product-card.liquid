{% doc %}
Renders a demo product card matching the commerce-card style.
{% enddoc %}

<article class="commerce-card">
  <div class="commerce-card-link">
    <a class="commerce-media-link" href="{{ url | default: '/products/coatguard-glide-3-in-1-shampoo-conditioner' }}" aria-label="View {{ title | escape }}">
      <div class="commerce-media">
        {% if image != blank %}
          <img src="{{ image | asset_url }}" alt="{{ title | escape }}" width="720" height="540" loading="lazy">
        {% else %}
          <img src="{{ 'product-shampoo-glide.svg' | asset_url }}" alt="{{ title | escape }}" width="720" height="540" loading="lazy">
        {% endif %}
        <span>{{ tag | default: 'Demo' }}</span>
      </div>
    </a>
    <div class="commerce-card-body">
      <div class="commerce-rating">★★★★★ <span>{{ rating | default: '4.8' }}</span></div>
      <h3><a href="{{ url | default: '/products/coatguard-glide-3-in-1-shampoo-conditioner' }}">{{ title }}</a></h3>
      <p>{{ benefit | default: 'Daily care product that supports cleaner teeth and fresher breath.' }}</p>
      <div class="commerce-price-row">
        <strong>{{ price }}</strong>
      </div>
      <div class="commerce-card-footer">
        <span>Fast details</span>
        <strong>View details</strong>
      </div>
      <a class="commerce-option-button" href="{{ url | default: '/products/coatguard-glide-3-in-1-shampoo-conditioner' }}">Add to cart</a>
    </div>
  </div>
</article>
