{%- comment -%}
  Storewide event item for the announcement bar. Nothing here is visible until
  theme.js confirms a RUNNING event from PawScout's /public/event feed (the
  same single fetch the welcome modal and hero badge use). It then clones this
  template to the front of every announcement set (the bar renders its set
  twice for the seamless mobile marquee, so both copies get one) and fills in
  "<name>: <pct>% off everything with code <code>, until <end>" from the feed.
  A planned-but-not-started event adds nothing: the bar only ever states an
  offer that is live right now. The markup below is structure only (icon and
  link target); every word a visitor reads comes from the feed.
{%- endcomment -%}
<template data-announcement-event-template>
  <p class="announcement-event">
    <span class="announcement-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M3.5 12.5V4.5h8l8.5 8.5-8 8z"/>
        <circle cx="7.5" cy="8.5" r="1.4"/>
      </svg>
    </span>
    <a href="{{ routes.all_products_collection_url }}"><strong data-event-name></strong> <span data-event-text></span></a>
  </p>
</template>
{% style %}
  .announcement-event a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .announcement-event a:hover span { text-decoration: underline; }
  @media (min-width: 901px) {
    /* Desktop shows the set as a static row, so a fourth slot has to keep
       the bar's 48px silhouette or the whole page jumps when the feed lands:
       the event takes two shares, and the three benefits condense to their
       bold titles while it runs (the mobile marquee keeps every word). */
    .announcement.has-event .announcement-set {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    }
    .announcement.has-event .announcement-set > p:not(.announcement-event) > span:not(.announcement-icon) {
      display: none;
    }
    .announcement-event a { row-gap: 0; line-height: 1.25; }
  }
  @media (min-width: 901px) and (max-width: 1120px) {
    .announcement-event { font-size: 12px; }
    .announcement-event strong { font-size: 14px; }
  }
{% endstyle %}
